# Settings are managed via the UI on port 8082 (stored in /app/data/presence.db).
# These env vars are only used as fallback defaults when not set in the database.
GRACE=180
NOTIFY_COOLDOWN=1800
IFACES=
WEBHOOK_URL=
LOG_LEVEL=INFO
ENV_FILE=/app/data/.env
SCAN_PREFIX=24
DB_PATH=/app/data/presence.db
SETTINGS_PORT=8082

# Scan reliability (arp-scan parameters used by the job).
# ARP_RETRIES: how many times each host is asked before giving up (default 3).
# ARP_TIMEOUT: milliseconds to wait for a reply per retry (default 500).
# Higher values reduce false "away" states for phones in Wi-Fi power-save mode.
# ARP_RETRIES=3
# ARP_TIMEOUT=500
# LOCK_PATH=/app/data/presence.lock

# Layer 1 - Passive sniffing daemon (ARP/mDNS/DHCP). Records "sightings" of
# your devices' traffic continuously, which is much more reliable than a
# point-in-time active scan. Needs CAP_NET_RAW + CAP_NET_ADMIN in the container.
# PASSIVE_SNIFF_ENABLED=true
# PASSIVE_SNIFF_IFACES=
#   (empty = same interfaces as IFACES)

# Layer 2 - Extra active scan method. `nmap -sn` runs in parallel with
# arp-scan and results are unioned. Known-IP devices missed by the scan are
# also probed directly (unicast arping/ping).
# USE_NMAP=true
# NMAP_BIN=nmap

# Layer 3 - A device only goes away after this many consecutive cycles with no
# signal (active or passive). Default 2.
# AWAY_CONFIRMATIONS=2

# Layer 3b - A device is only marked online (and the welcome is announced) after
# this many consecutive cycles WITH a signal. Symmetric debounce to avoid a
# single "blink" firing a false anyone_home at night. Default 2.
# HOME_CONFIRMATIONS=2

# Layer 3c - Night window: during these local hours a more tolerant grace and
# away_confirmations are used, so a phone in deep Wi-Fi power-save at night does
# not trigger a false away -> home cycle. Format HH:MM; "hasta" lower than
# "desde" crosses midnight (23:00-07:00). Empty = disabled.
# NIGHT_START=23:00
# NIGHT_END=07:00
# NIGHT_GRACE=600
# NIGHT_AWAY_CONFIRMATIONS=4

# Layer 3d - Quiet hours (optional): when an anyone_home event fires inside this
# window, the webhook and VoiceMonkey announcement are suppressed (the state
# change is still recorded). Format HH:MM, same midnight-crossing rules.
# QUIET_HOURS_START=23:00
# QUIET_HOURS_END=07:00

# Scan timeouts (seconds) per interface before a scan tool is discarded. Kept
# short so a dead/bogus interface (e.g. dummy0) does not burn 30s every cycle.
# ARP_SCAN_TIMEOUT=10
# NMAP_SCAN_TIMEOUT=10

# Layer 4 - Minimum seconds between webhooks of the same device
# (device_present / device_away). Default 300.
# DEVICE_NOTIFY_COOLDOWN=300

# Optional authentication for the settings UI (HTTP Basic Auth).
# The first time you open the UI it will ask you to create these anyway.
# SETTINGS_USERNAME=admin
# SETTINGS_PASSWORD_HASH=<bcrypt hash of the password>
#   Generate a hash with: htpasswd -nbBC 10 "" "yourpassword"  (take the 2nd field)
#   If you put this in a file, make sure the file has permissions 600.
#
# Optional: allow a specific cross-origin for /api/* (default: same-origin only).
# SETTINGS_CORS_ORIGIN=https://example.com